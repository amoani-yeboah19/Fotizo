{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run typecheck && pnpm run test && VITE_USE_MOCK_SHOP=true pnpm --filter @workspace/fotizo run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/fotizo/dist/public",
  "framework": null,
  "redirects": [
    {
      "source": "/dashboards",
      "destination": "https://fotizo-dashboards-demo.vercel.app/dashboards",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fotizo.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
