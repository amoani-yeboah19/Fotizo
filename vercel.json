{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run typecheck:libs && pnpm --filter @workspace/fotizo run typecheck && pnpm exec vitest run artifacts/fotizo --maxWorkers=2 && pnpm --filter @workspace/fotizo run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/fotizo/dist/public",
  "framework": null,
  "redirects": [
    {
      "source": "/dashboards",
      "destination": "https://fotizo-dashboards-demo.vercel.app/dashboards",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fotizo.onrender.com/api/:path*"
    },
    {
      "source": "/((?!.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
