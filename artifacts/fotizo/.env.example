# Fotizo frontend environment (Vite only exposes VITE_-prefixed vars to the app).
# Copy to `.env` and adjust. All values are optional; sensible defaults are built in.

# Base URL the API client prepends to every request. Default: /api
# Use the Vite /api proxy locally and the same-origin /api proxy in production.
VITE_API_BASE_URL=/api

# Data source toggle:
#   true  (default) — serve in-memory mock data; the app runs with no backend.
#   false           — call the real API at VITE_API_BASE_URL.
VITE_USE_MOCKS=true

# Demo shop data for local development only. Set false alongside VITE_USE_MOCKS
# when exercising the real API. Production must only show published inventory.
VITE_USE_MOCK_SHOP=true

# Google OAuth Client ID (Web application) from Google Cloud Console.
# Public value — safe to expose in the client bundle. Leave unset to hide
# the "Continue with Google" button (e.g. before credentials exist yet).
VITE_GOOGLE_CLIENT_ID=

# Extended manager previews are available only in an explicit demo build.
# Release builds use the server-backed manager console.
VITE_USE_MOCK_ADMIN=false
