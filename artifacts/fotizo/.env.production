# Production build config (public — VITE_ vars are embedded in the client bundle).
# Live auth and live catalogue data by default so the dashboards reflect the real
# shop and rep operations instead of fixture data.
VITE_USE_MOCKS=false
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_CATALOG=false
VITE_USE_MOCK_SELLER_CATALOG=false
VITE_USE_MOCK_ORDERS=false
VITE_USE_MOCK_ARTISANS=false
VITE_USE_MOCK_MESSAGES=false
# Shop inventory is published through the representative owner workflow.
# Unpublished imports remain hidden until pricing and inventory are reviewed.
VITE_USE_MOCK_SHOP=false
# Same-origin: Vercel proxies /api/* to the Render backend (see vercel.json).
# This makes the auth cookie first-party so iOS Safari (which blocks third-party
# cookies) keeps the session — fixing cross-domain login on mobile.
VITE_API_BASE_URL=/api
