# Copy to .env in this directory for local development; never commit credentials.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://fotizo:local-password@localhost:5432/fotizo
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Explicit frontend origins; comma-separated. Required in production.
CORS_ORIGIN=http://localhost:5173
# Set only to the verified number of trusted reverse-proxy hops in deployment.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=
# Display currency rate source (GBP base). Optional; defaults to ExchangeRate-API open access.
# CURRENCY_RATES_URL=https://open.er-api.com/v6/latest/GBP
# Online payment. Leave blank to offer offline payment only. Use test keys locally.
# Paystack (Ghana, charged in GHS): secret key; also verifies webhook signatures.
PAYSTACK_SECRET_KEY=
# Stripe (UK/US, charged in GBP): secret key and the webhook endpoint's signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where providers send buyers back after paying. Defaults to the first CORS_ORIGIN.
# APP_URL=https://fotizo.vercel.app
